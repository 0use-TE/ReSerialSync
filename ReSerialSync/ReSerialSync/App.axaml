<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ReSerialSync"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="ReSerialSync.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <semi:SemiTheme></semi:SemiTheme>
        <icons:MaterialIconStyles />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Application.Styles>
</Application>
