<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReSerialSync.ViewModels" xmlns:icons="using:Material.Icons.Avalonia" xmlns:models="using:ReSerialSync.Models"
             x:Class="ReSerialSync.Views.ReceiveView" x:Name="ReceiveRoot" x:DataType="vm:ReceiveViewModel">
    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Margin="12,4,12,6" IsEnabled="{Binding Workspace.HasSelection}">
        <WrapPanel ItemHeight="36" Margin="0,0,0,4">
            <CheckBox VerticalAlignment="Center" Content="{Binding Text[HexDisplay]}" IsChecked="{Binding Session.ReceiveHex, Mode=TwoWay}" Margin="0,0,12,0" />
            <CheckBox VerticalAlignment="Center" Content="{Binding Text[Timestamp]}" IsChecked="{Binding Session.ShowTimestamp, Mode=TwoWay}" Margin="0,0,12,0" />
            <CheckBox VerticalAlignment="Center" Content="{Binding Text[AutoScroll]}" IsChecked="{Binding Session.AutoScroll, Mode=TwoWay}" Margin="0,0,12,0" />
            <CheckBox VerticalAlignment="Center" Content="{Binding Text[Pause]}" IsChecked="{Binding Session.IsReceivePaused, Mode=TwoWay}" Margin="0,0,12,0" />
            <Button Classes="icon" ToolTip.Tip="{Binding Text[Clear]}" Command="{Binding Session.ClearReceiveCommand}" Margin="0,0,8,0"><icons:MaterialIcon Kind="DeleteOutline" Width="20" Height="20" /></Button>
            <Button Classes="icon" ToolTip.Tip="{Binding Text[Export]}" Command="{Binding Session.ExportReceiveCommand}" CommandParameter="{Binding #ReceiveRoot}"><icons:MaterialIcon Kind="Export" Width="20" Height="20" /></Button>
        </WrapPanel>
        <ListBox Grid.Row="1" x:Name="ReceiveBox" ItemsSource="{Binding Session.ReceiveLines}" SelectionMode="Multiple" Padding="12"
                 Background="Transparent" FontFamily="Cascadia Mono,Consolas,monospace"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ReceiveRow">
                    <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,monospace" MinHeight="18" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
